# ===========================================================================
# CARNITAS DON LOPE - POS Configuration
# ===========================================================================
# Copia este archivo a .env y completa los valores
# NO commits .env al repositorio (está en .gitignore)
# ===========================================================================

# Servidor
PORT=3000
NODE_ENV=production
SESSION_SECRET=genera_con_npm_run_secret_min_24_caracteres
SESSION_HORAS=8
MENU_CACHE_SEGUNDOS=30

# Google Apps Script URL (obten del dashboard de Apps Script)
# El URL debe terminar en /exec, no /edit ni /dev
GAS_URL=https://script.google.com/macros/s/AKfycbzPmD1E4kH59Fy2Epnf86WFP0FJBVfm1jhqCMWP6WUytaf-M2nL6XbFxmH7Eu0Df5JG/exec

# ===========================================================================
# SUCURSALES (hasta 20)
# ===========================================================================
# Usa el mismo patrón para más sucursales
SUCURSAL_1_ID=carnitas-principal
SUCURSAL_1_NOMBRE=Principal
SUCURSAL_1_PASS=hash_bcrypt_o_texto_plano

# ===========================================================================
# CLAVES DE ACCESO (genera hashes con: npm run hash -- "tu_clave")
# ===========================================================================
CLAVE_ADMIN=hash_bcrypt_gestion
CLAVE_DEV=hash_bcrypt_productos
CLAVE_DUENO=hash_bcrypt_panel

# ===========================================================================
# NOTAS
# ===========================================================================
# - Las claves se comparan con bcrypt si empiezan con $2, de lo contrario 
#   se compara en tiempo constante (más seguro para texto plano)
# - El token de sesión dura SESSION_HORAS horas
# - En modo demo (sin GAS_URL) se usan archivos JSON locales